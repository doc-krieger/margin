          "name": "comments_selection_anchor_check",
          "value": "(\"comments\".\"scope\" <> 'selection' OR (\"comments\".\"document_path\" IS NOT NULL AND \"comments\".\"anchor_quote\" IS NOT NULL AND \"comments\".\"anchor_start\" IS NOT NULL AND \"comments\".\"anchor_end\" IS NOT NULL))"
        },
